# ─────────────────────────────────────────────────────────────────────────────
# RAG Agent — environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="RAG Agent API"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ── Provider Selection ─────────────────────────────────────────────────────
# Options for LLM_PROVIDER: "gemini" | "lmstudio" | "ollama" | "openai" | "local"
LLM_PROVIDER=lmstudio
# Options for EMBEDDING_PROVIDER: "gemini" | "lmstudio" | "ollama" | "openai" | "local"
EMBEDDING_PROVIDER=lmstudio

# ── PROFILE 1: Local LLM / LM Studio / Ollama / vLLM (Offline) ───────────────
# When running backend locally outside Docker: use http://localhost:1234/v1
# When running backend inside Docker: use http://host.docker.internal:1234/v1
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_API_KEY=not-needed
LOCAL_LLM_MODEL=default
LOCAL_EMBEDDING_MODEL=nomic-embed-text
# LOCAL_EMBEDDING_BASE_URL=http://localhost:1234/v1

# Common embedding dimensions:
# - nomic-embed-text: 768
# - bge-m3: 1024
# - all-MiniLM-L6-v2: 384
# - gemini-embedding-001: 3072
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=5

# ── PROFILE 2: Google Gemini (Cloud) ──────────────────────────────────────────
# Required only if LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
# EMBEDDING_DIMENSION=3072

# ── RAG retrieval ──────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=5
MAX_HISTORY_PAIRS=5

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres           # 'postgres' inside Docker, 'localhost' for local dev
POSTGRES_PORT=5432
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ragdb

# ── Qdrant ─────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant               # 'qdrant' inside Docker, 'localhost' for local dev
QDRANT_PORT=6333
QDRANT_API_KEY=                  # leave blank for self-hosted; required for Qdrant Cloud
QDRANT_COLLECTION=documents

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins; use * for development only
CORS_ORIGINS=["*"]

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
